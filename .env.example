# Copy to .env.local, then fill in your own key. Do not commit .env.local.
# Chat model: DashScope by default.
DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
RAG_MODEL=qwen-max

# Optional OpenAI-compatible chat provider.
# RELAY_API_KEY=
# RELAY_BASE_URL=https://your-provider.example/v1
# DASHSCOPE_MODEL=your-model-name
# RAG_MODEL=your-model-name
STRUCTURED_OUTPUT_METHOD=auto

# Embeddings are independent from the chat provider.
# This example uses DashScope so no local Ollama installation is needed.
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
# To use local Ollama instead, set EMBEDDING_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_EMBEDDING_MODEL=bge-m3

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000
UPLOAD_PATH=./uploads
RAG_TOP_K=3
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100
PROMETHEUS_MOCK_ENABLED=True
PROMETHEUS_BASE_URL=http://localhost:9090
CLS_MOCK_ENABLED=True
MCP_ENABLED=False
MCP_CONNECT_TIMEOUT=10
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_URL=http://localhost:8004/mcp
